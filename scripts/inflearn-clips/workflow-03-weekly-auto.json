{
  "name": "03. 매주 월요일 정산 알림톡 완전 자동화",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000001",
      "name": "매주 월요일 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "지난주_시작",
              "value": "={{ $now.minus({days: $now.weekday + 6}).toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "지난주_끝",
              "value": "={{ $now.minus({days: $now.weekday}).toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "정산_주차",
              "value": "={{ $now.toFormat('yyyy년 M월') }} {{ Math.ceil(($now.day)/7) }}주차"
            }
          ]
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000002",
      "name": "지난주 날짜 계산",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [460, 300]
    },
    {
      "parameters": {
        "documentId": { "value": "여기에_구글시트_ID_입력", "mode": "id" },
        "sheetName": { "value": "기사정산", "mode": "name" },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "정산주차",
              "lookupValue": "={{ $json.정산_주차 }}"
            }
          ]
        },
        "options": { "headerRow": 1 }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000003",
      "name": "해당 주차 정산 데이터",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [680, 300],
      "credentials": { "googleSheetsOAuth2Api": { "id": "google-sheets-cred", "name": "Google Sheets" } }
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "has-data",
              "leftValue": "={{ $items().length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000004",
      "name": "데이터 있음?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://kakaoapi.aligo.in/akv10/alimtalk/send/",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "apikey", "value": "여기에_알리고_API_KEY" },
            { "name": "userid", "value": "여기에_알리고_아이디" },
            { "name": "senderkey", "value": "여기에_카카오_발신키" },
            { "name": "tpl_code", "value": "여기에_템플릿_코드" },
            { "name": "sender", "value": "051-711-3103" },
            { "name": "receiver_1", "value": "={{ $json.휴대폰.replace(/-/g, '') }}" },
            { "name": "recvname_1", "value": "={{ $json.이름 }}" },
            {
              "name": "message_1",
              "value": "={{ `[${$('지난주 날짜 계산').item.json.정산_주차} 정산 완료]\\n\\n안녕하세요 ${$json.이름}님 👋\\n\\n이번 주 정산이 완료되었습니다.\\n\\n📦 배송 건수: ${$json.건수}건\\n💰 정산금액: ${Number($json.정산금액).toLocaleString()}원\\n✅ 입금 예정: 매주 화요일\\n\\n문의: 051-711-3103` }}"
            },
            { "name": "subject_1", "value": "주간 정산 완료" }
          ]
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000005",
      "name": "알림톡 발송",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 220]
    },
    {
      "parameters": {
        "unit": "seconds",
        "resume": "timeInterval",
        "value": 1
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000006",
      "name": "발송 간격",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1340, 220],
      "webhookId": "wait-webhook-03"
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000007",
      "name": "전체 취합",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [1560, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://kakaoapi.aligo.in/akv10/alimtalk/send/",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "apikey", "value": "여기에_알리고_API_KEY" },
            { "name": "userid", "value": "여기에_알리고_아이디" },
            { "name": "senderkey", "value": "여기에_카카오_발신키" },
            { "name": "tpl_code", "value": "관리자_완료_알림_템플릿" },
            { "name": "sender", "value": "051-711-3103" },
            { "name": "receiver_1", "value": "관리자_휴대폰번호" },
            { "name": "recvname_1", "value": "관리자" },
            {
              "name": "message_1",
              "value": "={{ `[자동화 완료]\\n${$('지난주 날짜 계산').item.json.정산_주차} 정산 알림톡\\n총 ${$json.data.length}명 발송 완료\\n완료시각: ${$now.toFormat('HH:mm')}` }}"
            },
            { "name": "subject_1", "value": "자동화 완료 보고" }
          ]
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000008",
      "name": "관리자 완료 알림",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1780, 220]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "상태", "value": "데이터 없음 — 정산 데이터 확인 필요" },
            { "name": "주차", "value": "={{ $('지난주 날짜 계산').item.json.정산_주차 }}" }
          ]
        }
      },
      "id": "c3d4e5f6-0003-0003-0003-000000000009",
      "name": "데이터 없음 처리",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1120, 420]
    }
  ],
  "connections": {
    "매주 월요일 09:00": { "main": [[{ "node": "지난주 날짜 계산", "type": "main", "index": 0 }]] },
