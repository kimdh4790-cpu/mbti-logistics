{
  "name": "02. 구글 시트 → 카카오 알림톡 일괄 발송",
  "nodes": [
    {
      "parameters": {},
      "id": "b2c3d4e5-0002-0002-0002-000000000001",
      "name": "수동 실행",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "documentId": { "value": "여기에_구글시트_ID_입력", "mode": "id" },
        "sheetName": { "value": "정산데이터", "mode": "name" },
        "filtersUI": {},
        "options": { "headerRow": 1 }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "구글 시트 읽기",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [460, 300],
      "credentials": { "googleSheetsOAuth2Api": { "id": "google-sheets-cred", "name": "Google Sheets" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "id": "check-phone",
              "leftValue": "={{ $json.휴대폰 }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "수신자 있음?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://kakaoapi.aligo.in/akv10/alimtalk/send/",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "apikey", "value": "여기에_알리고_API_KEY" },
            { "name": "userid", "value": "여기에_알리고_아이디" },
            { "name": "senderkey", "value": "여기에_카카오_발신키" },
            { "name": "tpl_code", "value": "여기에_템플릿_코드" },
            { "name": "sender", "value": "051-711-3103" },
            { "name": "receiver_1", "value": "={{ $json.휴대폰.replace(/-/g, '') }}" },
            { "name": "recvname_1", "value": "={{ $json.이름 }}" },
            {
              "name": "message_1",
              "value": "={{ `안녕하세요 ${$json.이름}님\\n\\n${$json.날짜} 정산 내역입니다.\\n\\n총 건수: ${$json.건수}건\\n정산금액: ${Number($json.정산금액).toLocaleString()}원\\n\\n자세한 내역은 앱에서 확인하세요.` }}"
            },
            { "name": "subject_1", "value": "정산 완료 안내" }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "알림톡 발송",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 220]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": { "reset": false }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000005",
      "name": "1초 간격 대기",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [900, 140]
    },
    {
      "parameters": {
        "unit": "seconds",
        "resume": "timeInterval",
        "value": 1
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000006",
      "name": "1초 대기",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1100, 140],
      "webhookId": "wait-webhook-02"
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000007",
      "name": "결과 취합",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [1300, 220]
    },
    {
      "parameters": {
        "values": {
          "number": [
            { "name": "총_발송수", "value": "={{ $json.data.length }}" }
          ],
          "string": [
            { "name": "완료시각", "value": "={{ $now.toFormat('yyyy-MM-dd HH:mm:ss') }}" },
            { "name": "상태", "value": "발송 완료" }
          ]
        }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000008",
      "name": "완료 요약",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1500, 220]
    }
  ],
  "connections": {
    "수동 실행": { "main": [[{ "node": "구글 시트 읽기", "type": "main", "index": 0 }]] },
    "구글 시트 읽기": { "main": [[{ "node": "수신자 있음?", "type": "main", "index": 0 }]] },
    "수신자 있음?": {
      "main": [
        [{ "node": "1초 간격 대기", "type": "main", "index": 0 }],
