      ]
    },
    "1초 간격 대기": { "main": [[{ "node": "알림톡 발송", "type": "main", "index": 0 }]] },
    "알림톡 발송": { "main": [[{ "node": "1초 대기", "type": "main", "index": 0 }]] },
    "1초 대기": { "main": [[{ "node": "결과 취합", "type": "main", "index": 0 }]] },
    "결과 취합": { "main": [[{ "node": "완료 요약", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": true },
  "notes": "구글 시트 컬럼명: 이름 / 휴대폰 / 날짜 / 건수 / 정산금액",
  "tags": [{ "name": "카카오 알림톡" }, { "name": "구글 시트" }, { "name": "일괄 발송" }]
