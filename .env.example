# ══════════════════════════════════════════════════════
# MBTICO 소셜미디어 파이프라인 환경변수 템플릿
# Oracle Cloud ~/.env 에 복사 후 실제 값 입력
# ══════════════════════════════════════════════════════
# 이 파일은 git에 커밋해도 됨 (실제 값 없음)
# 실제 .env 파일은 절대 git에 커밋 금지
# ══════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────
# [1] 네이버 CLOVA Voice TTS (한국어 나레이션)
# 발급: https://console.ncloud.com → AI·NAVER API → CLOVA Voice
# 무료: 월 2만자 / 유료: 월 1만원 기본
# ──────────────────────────────────────────────────────
NAVER_TTS_CLIENT_ID=
NAVER_TTS_CLIENT_SECRET=

# ──────────────────────────────────────────────────────
# [2] YouTube Data API v3 (영상 업로드)
# 발급: https://console.cloud.google.com
#   → API 및 서비스 → YouTube Data API v3 활성화
#   → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID 생성
#     (애플리케이션 유형: 데스크톱 앱)
#   → get-youtube-token.js 실행 → refresh_token 발급
# 무료: 10,000 유닛/일 (업로드 = 1,600유닛)
# ──────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ──────────────────────────────────────────────────────
# [3] ElevenLabs TTS (한국어 나레이션 대안)
# 발급: https://elevenlabs.io → Profile → API Key
# 무료: 월 10,000자
# NAVER_TTS 없을 때 자동 fallback으로 사용됨
# ──────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ──────────────────────────────────────────────────────
# [4] FILO/DINE 테스트 계정 (앱 내부 화면 녹화용)
# ──────────────────────────────────────────────────────
MBTICO_ADMIN_EMAIL=soungkyekim@naver.com
MBTICO_ADMIN_PW=
MBTICO_DEALER_ID=9XD2K3W1tIhIs6XM74YT0xfRFEP2

# ──────────────────────────────────────────────────────
# [5] 네이버 블로그 (Playwright 방식, API 없음)
# ──────────────────────────────────────────────────────
NAVER_BLOG_ID=

# ──────────────────────────────────────────────────────
# [6] 실행 환경 설정
# ──────────────────────────────────────────────────────
HEADLESS=true
CHROMIUM_PATH=/usr/bin/chromium
PROFILES_DIR=/home/opc/.mbtico-profiles
